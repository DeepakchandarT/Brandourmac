SPONSOR_INVITE_CODE=replace-with-a-private-code
SPONSOR_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-server-only-token
# Use different namespaces (and preferably databases) for Preview and Production.
CAMPAIGN_NAMESPACE=postiz-preview
# Optional email notification. Offers are saved even when email is unconfigured.
OFFER_EMAIL=private-recipient@example.com
RESEND_API_KEY=re_replace-with-your-key
RESEND_FROM_EMAIL=Partnership Proposal <proposal@your-verified-domain.com>
